{
  "name": "graphinity",
  "version": "0.1.3",
  "description": "Interactive, recursive architecture diagrams from YAML/JSON files: a CLI with live reload and static site generation.",
  "license": "MPL-2.0",
  "homepage": "https://leptitbiscuit.github.io/Graphinity/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LePtitBiscuit/Graphinity.git"
  },
  "bugs": {
    "url": "https://github.com/LePtitBiscuit/Graphinity/issues"
  },
  "type": "module",
  "keywords": [
    "architecture",
    "architecture-diagram",
    "diagram",
    "yaml",
    "json",
    "cli",
    "static-site",
    "vue-flow",
    "elkjs",
    "simple-icons",
    "visualization",
    "iconify",
    "documentation"
  ],
  "engines": {
    "node": ">=22.4.0"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "graphinity": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "!dist/cli/*.d.ts",
    "licenses"
  ],
  "scripts": {
    "dev": "pnpm run --parallel \"/^dev:/\"",
    "dev:viewer": "vite",
    "dev:docs": "vitepress dev docs",
    "cli": "node src/cli/index.ts",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && pnpm run build:lib && pnpm run build:viewer",
    "build:lib": "tsc -p tsconfig.build.json",
    "build:viewer": "vite build",
    "typecheck": "tsc -p tsconfig.json && vue-tsc -p viewer/tsconfig.json",
    "lint": "tsc -p tsconfig.json --noUnusedLocals --noUnusedParameters && vue-tsc -p viewer/tsconfig.json --noUnusedLocals --noUnusedParameters && node --check scripts/check-package.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm run build && playwright test",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run typecheck && pnpm test",
    "docs:dev": "vitepress dev docs",
    "docs:check": "node docs/scripts/check-examples.ts",
    "docs:demo": "pnpm run build && node src/cli/index.ts build examples/kestrel/architecture.yml --out docs/public/demo",
    "docs:build": "pnpm run docs:check && pnpm run docs:demo && vitepress build docs",
    "brand": "node scripts/brand.ts",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@iconify-json/devicon": "^1.2.84",
    "@iconify-json/logos": "^1.2.20",
    "@iconify-json/vscode-icons": "^1.2.100",
    "simple-icons": "^16.38.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "@xyflow/vue": "^2.0.2",
    "elkjs": "^0.12.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitepress": "1.6.4",
    "vitest": "^5.1.1",
    "vue": "^3.5.46",
    "vue-tsc": "^3.3.14"
  }
}
